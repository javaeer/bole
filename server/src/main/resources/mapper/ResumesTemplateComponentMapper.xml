<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.net.yunlou.bole.mapper.ResumesTemplateComponentMapper">

    <resultMap id="resumesTemplateComponentResultMap" type="cn.net.yunlou.bole.entity.ResumesTemplateComponent">
        <id property="id" column="id"/>
        <result property="deleted" column="deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

        <result property="name" column="name"/>
        <result property="component" column="component"/>
        <result property="props" column="props"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="styles" column="styles"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>



    </resultMap>

    <select id="selectListByTemplateId" resultMap="resumesTemplateComponentResultMap">
        select *
        from t_resumes_template_component
        where template_id = #{templateId}
          and deleted = 0
    </select>
</mapper>