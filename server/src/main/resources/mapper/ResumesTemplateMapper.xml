<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.net.yunlou.bole.mapper.ResumesTemplateMapper">

    <resultMap id="BaseResultMap" type="cn.net.yunlou.bole.model.entity.ResumesTemplate">
        <!-- 继承 BaseEntity 的字段 -->
        <id column="id" property="id"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>

        <!-- ResumesTemplate 特有字段 -->
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="description" property="description"/>
        <result column="preview_image" property="previewImage"/>
        <result column="is_active" property="isActive"/>
        <result column="version" property="version"/>

        <!-- JSON 类型字段，使用 typeHandler -->
        <result column="global_style" property="globalStyle"
                typeHandler="cn.net.yunlou.bole.common.handler.JsonbTypeHandler"/>
        <result column="global_layout" property="globalLayout"
                typeHandler="cn.net.yunlou.bole.common.handler.JsonbTypeHandler"/>

        <collection column="id" property="components"
                    select="cn.net.yunlou.bole.mapper.ResumesTemplateComponentMapper.selectListByTemplateId"/>
    </resultMap>

</mapper>