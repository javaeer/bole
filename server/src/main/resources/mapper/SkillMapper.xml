<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.net.yunlou.bole.mapper.SkillMapper">

    <resultMap id="BaseResultMap" type="cn.net.yunlou.bole.model.entity.Skill">
        <!-- 继承 BaseEntity 的字段 -->
        <id column="id" property="id"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>

        <!--  特有字段 -->

        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="level" property="level"/>
        <result column="category" property="category"/>
        <result column="description" property="description"/>
        <result column="proficiency_percent" property="proficiencyPercent"/>
        <result column="experience_years" property="experienceYears"/>
        <result column="is_certified" property="isCertified"/>
        <result column="certificate_name" property="certificateName"/>
        <result column="certificate_date" property="certificateDate"/>
        <result column="is_public" property="isPublic"/>
        <result column="sort" property="sort"/>


        <!-- JSON 类型字段，使用 typeHandler -->
        <result column="tags" property="tags"
                typeHandler="cn.net.yunlou.bole.common.handler.JsonbTypeHandler"/>
    </resultMap>


</mapper>