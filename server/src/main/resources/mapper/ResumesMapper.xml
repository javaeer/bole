<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.net.yunlou.bole.mapper.ResumesMapper">
    <resultMap id="BaseResultMap" type="cn.net.yunlou.bole.model.entity.Resumes">
        <!-- 继承 BaseEntity 的字段 -->
        <id column="id" property="id"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>

        <!-- Resumes 特有字段 -->
        <result column="user_id" property="userId"/>
        <result column="template_id" property="templateId"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="view_count" property="viewCount"/>
        <result column="download_count" property="downloadCount"/>

        <!-- JSON 类型字段，使用 typeHandler -->
        <result column="global_style" property="globalStyle"
                typeHandler="cn.net.yunlou.bole.common.handler.JsonbTypeHandler"/>
        <result column="global_layout" property="globalLayout"
                typeHandler="cn.net.yunlou.bole.common.handler.JsonbTypeHandler"/>
        <result column="components" property="components"
                typeHandler="cn.net.yunlou.bole.common.handler.JsonbTypeListHandler$ResumesTemplateComponentListHandler"/>

        <association column="template_id" property="template"
                     select="cn.net.yunlou.bole.mapper.ResumesTemplateMapper.selectById"/>
    </resultMap>
</mapper>