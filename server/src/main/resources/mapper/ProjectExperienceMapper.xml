<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.net.yunlou.bole.mapper.ProjectExperienceMapper">

    <resultMap id="BaseResultMap" type="cn.net.yunlou.bole.model.entity.ProjectExperience">
        <!-- 继承 BaseEntity 的字段 -->
        <id column="id" property="id"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>

        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="description" property="description"/>
        <result column="sort" property="sort"/>


        <!-- JSON 类型字段，使用 typeHandler -->
        <result column="achievements" property="achievements"
                typeHandler="cn.net.yunlou.bole.common.handler.JsonbTypeHandler"/>
    </resultMap>

</mapper>